# GEMINI_API_KEY: Legacy AI field workflow only. Keep server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: public application URL.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# VITE_* values are browser-visible by design. Never place service-role/admin secrets here.
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# N8N WEBHOOK CONFIGURATION
VITE_N8N_GENERATION_WEBHOOK_URL="https://agencia-asserto.app.n8n.cloud/webhook/vipaz/caw/generation"
N8N_DOCX_WEBHOOK_URL="https://agencia-asserto.app.n8n.cloud/webhook/vipaz/caw/docx"

# LEGAL AI — current n8n-assisted field workflow
LEGAL_AI_N8N_WEBHOOK_URL="https://your-n8n.example/webhook/legal-ai"
LEGAL_AI_N8N_SECRET="SERVER_SIDE_SECRET"

# OPENAI LEGAL INTELLIGENCE — Phase 5.1
# Server-side only. Never prefix with VITE_.
OPENAI_API_KEY="SERVER_SIDE_OPENAI_KEY"
LEGAL_INTELLIGENCE_ENGINE_ENABLED="false"

# ENGINE ARCHITECTURE & CLIENT FEATURE FLAGS
VITE_DETERMINISTIC_ENGINE_ENABLED="true"
VITE_AI_PREFILL_ENABLED="false"
VITE_AI_REVIEW_ENABLED="false"
